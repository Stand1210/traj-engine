# Python 构建产物
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# 虚拟环境
.venv/
venv/
env/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 本地临时脚本（本项目 house rule：调参/验证草稿一律 _ 前缀，用完即删，不入库）
/_*.py
/_*.txt
/_*.json
/_*.jsonl
/_*.log
/_*.md
/_tmp*/
!/__init__.py

# 本地凭据 / 环境
.env
*.pem
*.key

# 平台租户档案：示例可入库，真实凭据不入库
platform/config/tenants/*.yaml
!platform/config/tenants/example.yaml

# M1 本地运行产物
platform/var/

# 前端依赖与构建产物
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
